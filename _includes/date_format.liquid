{% assign months = 'january|february|march|april|may|june|july|august|september|october|november|december' | split: '|' %}

{% assign m = include.date | date: '%-m' | minus: 1 %}
{% assign day = include.date | date: '%d' %}
{% assign year = include.date | date: '%Y' %}

{% assign month_key = months[m] %}

{%- if site.active_lang == 'en-us' -%}
  {% assign month = site.data.en-us.strings.months.short[month_key] %}
  {{ month }} {{ day }}, {{ year }}

{%- elsif site.active_lang == 'vi' or site.active_lang == 'pt-br' -%}
  {% assign lang = site.active_lang %}
  {% assign month = site.data[lang].strings.months.short[month_key]
    | default: site.data[lang].strings.months.long[month_key] %}
  {{ day }} {{ month }} {{ year }}

{%- elsif site.active_lang == 'fr-ca' -%}
  {% assign month = site.data.fr-ca.strings.months.long[month_key] %}
  {{ day }} {{ month }}, {{ year }}

{%- else -%}
  {{ day }} {{ month_key }} {{ year }}
{%- endif -%}
