{% if site.active_lang == 'vi-vn' %}
  <div class="projects-showcase">
    <section class="projects-overview">
      <div class="projects-overview__copy">
        <p class="projects-eyebrow">Nghiên cứu và phát triển hệ thống</p>
        <h2>Nền tảng tự hành, robot thông minh và cảm biến cho môi trường thực</h2>
        <p>
          AVIS Lab phát triển các hệ thống robot từ tầng cảm biến, định vị, điều khiển đến thử nghiệm nguyên mẫu. Các dự án tập trung vào UAV, UUV,
          SLAM, LiDAR, stereo vision và các bài toán AI ứng dụng trong robot.
        </p>
        <div class="projects-actions">
          <a class="projects-action" href="{{ '/news/' | relative_url }}">
            <i class="ti ti-news"></i>
            Tin mới
          </a>
          <a class="projects-action" href="{{ '/people/' | relative_url }}">
            <i class="ti ti-users"></i>
            Nhóm nghiên cứu
          </a>
        </div>
      </div>
      <dl class="projects-metrics">
        <div>
          <dt>5</dt>
          <dd>hướng dự án chính</dd>
        </div>
        <div>
          <dt>UAV/UUV</dt>
          <dd>nền tảng robot tự hành</dd>
        </div>
        <div>
          <dt>AI + Sensors</dt>
          <dd>nhận thức, định vị, điều khiển</dd>
        </div>
      </dl>
    </section>

    <section class="projects-section">
      <div class="projects-section__header">
        <p class="projects-eyebrow">Dự án nổi bật</p>
        <h2>UAV và AI hỗ trợ chữa cháy, cứu nạn cứu hộ</h2>
        <p>
          Đề tài cấp Bộ do TS. Phạm Hoàng Anh chủ trì, hướng tới hệ thống UAV tích hợp camera quang học, camera nhiệt, trạm mặt đất và AI phân tích
          hiện trường.
        </p>
      </div>
      <a class="project-featured" href="{{ '/news/2026-05-18-uav-ai-fire-rescue-project/' | relative_url }}">
        <div class="project-featured__media">
          {% include figure.liquid loading="lazy" path="assets/img/uav1.png" sizes="(min-width: 992px) 46vw, 95vw" alt="UAV research platform" class="img-fluid" %}
        </div>
        <div class="project-featured__body">
          <span class="project-status"><i class="ti ti-flask"></i> Đề tài cấp Bộ</span>
          <h3>Hệ thống UAV, bản đồ số và AI nhận diện hiện trường</h3>
          <p>
            Tập trung vào bay tự động, thu thập dữ liệu camera, hiển thị dữ liệu thời gian thực, phân tích quy mô đám cháy và phát hiện người trong
            khu vực quan sát.
          </p>
          <div class="project-tags">
            <span>UAV</span>
            <span>Thermal camera</span>
            <span>AI perception</span>
            <span>Mission planning</span>
          </div>
          <span class="project-link-label">
            Xem chi tiết
            <i class="ti ti-arrow-right"></i>
          </span>
        </div>
      </a>
    </section>

    <section class="projects-section">
      <div class="projects-section__header">
        <p class="projects-eyebrow">Năng lực triển khai</p>
        <h2>Các mảng kỹ thuật AVIS Lab đang xây dựng</h2>
      </div>
      <div class="projects-capability-grid">
        <div class="projects-capability">
          <i class="ti ti-map-2"></i>
          <h3>SLAM và định vị</h3>
          <p>Bản đồ hóa, tracking, visual-inertial odometry và quản lý bản đồ cho robot di động.</p>
        </div>
        <div class="projects-capability">
          <i class="ti ti-drone"></i>
          <h3>UAV tự hành</h3>
          <p>Thiết kế khung, tích hợp payload, trạm mặt đất, telemetry và bay theo nhiệm vụ.</p>
        </div>
        <div class="projects-capability">
          <i class="ti ti-submarine"></i>
          <h3>Robot dưới nước</h3>
          <p>Điều khiển độ sâu, hướng, mô phỏng nhiệm vụ và thu thập dữ liệu môi trường.</p>
        </div>
        <div class="projects-capability">
          <i class="ti ti-radar"></i>
          <h3>Cảm biến 3D</h3>
          <p>LiDAR, stereo camera và sensor fusion phục vụ nhận thức không gian.</p>
        </div>
      </div>
    </section>

    <section class="projects-section">
      <div class="projects-section__header">
        <p class="projects-eyebrow">Danh mục dự án</p>
